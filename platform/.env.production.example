# Production settings for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production   (then fill it in)
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production is gitignored. Everything here is either a secret or specific
# to one deployment; anything public about a cluster lives in
# packages/shared/src/clusters.ts instead.

# --- where and what --------------------------------------------------------
# The hostname the site answers on. Caddy gets a certificate for exactly this,
# so the DNS A record must already point at this box or startup will fail.
DESC_DOMAIN=desc.example.com

# local | devnet | mainnet. Selects RPC, program ids and the settlement mint.
DESC_ENV=devnet

# Which moderator key folder to mount: apps/api/moderators/<MOD_SET>
MOD_SET=devnet

# --- secrets ---------------------------------------------------------------
POSTGRES_PASSWORD=
# Gates /admin/*. Long and random: `openssl rand -hex 32`
ADMIN_TOKEN=

# Claude Code's headless credential, so the moderators judge on the
# SUBSCRIPTION rather than billed API usage. Generate on a machine you can log
# in to:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# --- from `pnpm bootstrap` on this cluster ---------------------------------
CONFIG_AUTHORITY=

# ONLY on localnet, where bootstrap creates a stand-in currency. devnet settles
# in Circle's real USDC and mainnet in the real one, both pinned in
# packages/shared/src/clusters.ts — the api refuses to start if you set a
# conflicting value there.
#USDC_MINT=

# --- optional --------------------------------------------------------------
# Override the cluster's default RPC. The public devnet endpoint allows 100
# requests per 10s; set a Helius/QuickNode URL here if you see 429s.
#RPC_URL=

# fs keeps deliverables on the box's disk (a Docker volume, backed up with it).
# s3 moves them to any S3-compatible store — see apps/api/.env for those keys.
STORAGE_DRIVER=fs

# claude = subscription (Claude Code) · claude-api = billed API usage
DESC_JUDGE=claude

# Moderator slugs that judge honestly and then submit the OPPOSITE verdict, so
# a panel can be seen outvoting a bad panellist. This both ENABLES the inversion
# and makes the UI badge them as test moderators — leave it unset and Mischief
# would be advertised as an ordinary judge. Refused entirely on mainnet.
DESC_MISCHIEF_MODS=mischief

# Which model each moderator judges with.
MODEL_OLYMPUS_MOD_CLAUDE_OPUS=claude-opus-5
MODEL_SONGOKU_MOD_CLAUDE_SONNET=claude-sonnet-5
MODEL_HIKARU_MOD_CLAUDE_HAIKU=claude-haiku-4-5
MODEL_MISCHIEF=claude-haiku-4-5
