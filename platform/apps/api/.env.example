# Copy to .env and fill in.

PORT=3000
RPC_URL=http://127.0.0.1:8899
DATABASE_URL=postgres://desc:desc@localhost:5432/desc

# Platform key — Config authority AND settlement authority (MVP).
# On localnet, the Anchor deployer key works fine:
PLATFORM_KEYPAIR_PATH=~/.config/solana/id.json

# Set this from the output of `pnpm bootstrap`.
USDC_MINT=
