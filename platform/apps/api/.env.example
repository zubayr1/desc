# Copy to .env and fill in.

PORT=3000
RPC_URL=http://127.0.0.1:8899
DATABASE_URL=postgres://desc:desc@localhost:5432/desc

# Cold admin authority PUBKEY (Config.authority). Just the pubkey — the api
# never signs admin actions. On localnet this is the Anchor deployer's address
# (`solana address`). Printed by `pnpm bootstrap`.
CONFIG_AUTHORITY=

# Hot settlement key — the ONLY secret the api loads (signs record_verdict).
# Generated + saved by `pnpm bootstrap`.
SETTLEMENT_KEYPAIR_PATH=./settlement-keypair.json

# Set from the output of `pnpm bootstrap`.
USDC_MINT=

# --- Claude (AI moderator) ---------------------------------------------------
# API key from console.anthropic.com/settings/keys. Takes precedence over any
# `ant auth login` profile, so setting it here is all that's needed.
# Leave EMPTY rather than blank-assigning if you'd rather use an OAuth profile:
# an empty value still wins the precedence slot and authenticates as empty.
ANTHROPIC_API_KEY=

# --- AI moderators ------------------------------------------------------------
# Which judge mod-run / mod-watch use:
#   claude      the Claude SUBSCRIPTION, via Claude Code headless — no API credits
#   claude-api  the Anthropic API, billed as API usage (a host with no Claude Code login)
#   manual      settle by hand: `pnpm mod-run <ref> pass|fail`
DESC_JUDGE=claude
# The model each moderator judges with, one line per moderator, keyed by its slug
# (the label lower-cased with dashes → upper-case with underscores). A moderator
# with no line here refuses to start. moderator-register prints the exact line.
MODEL_OLYMPUS_MOD_CLAUDE_OPUS=claude-opus-5
MODEL_HIKARU_MOD_CLAUDE_HAIKU=claude-haiku-4-5
